# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp logs
.playwright-mcp/

# compiled database output
/database/dist/

# verification/scratch screenshots
verify-*.png
*.png

# ...but evidence under data/ is the deliverable, not scratch. The blanket *.png above was
# added for scratch captures and reached further than intended: it was silently dropping 61
# PNGs of real bug evidence and feature screenshots across eptts-mobile, which looked present
# on disk and simply never existed for anyone else. Nothing warns you — the file is there, the
# bug references it, and the attachment is absent from every clone.
!data/**/bugs/**/*.png
!data/**/features/**/screenshots/*.png
# eptts keeps some evidence in a top-level attachments/ tree rather than beside the bug.
!data/**/attachments/**/*.png

# automation hub — run artifacts (videos/traces) are regenerated on every replay
automation-hub/projects/*/runs/
# automation hub — cached login state (contains session cookies; recreated on demand)
automation-hub/.auth/
test-results/

# Generated artifacts
__pycache__/
scripts/.assembled-prompt-*.txt
backups/

# Transient: the recorder writes the list of cases held back for infrastructure reasons.
automation-hub/rerun-cases-*.txt
probe-*-tmp.js
