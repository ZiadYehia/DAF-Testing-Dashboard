                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or expired bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NestError"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but this role may not call this endpoint.",
            "content": {
