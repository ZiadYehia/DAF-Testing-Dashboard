# Automation Hub environment — copy to automation-hub/.env (gitignored) and fill in.
# Values are loaded into the Playwright child process by playwright.config.ts;
# specs reference them as process.env.<KEY> instead of hardcoding secrets/URLs.
#
# The hub targets many apps: prefix keys with the app (MYAPP_, CRM_, …) and register
# each app's slug + base-URL key + login flow in lib/apps.ts.

# ── myapp (example) ──────────────────────────────────────────────────────────
# Base URL of the app under test (no trailing slash)
MYAPP_BASE_URL=https://myapp.example.com
# Login used by the myapp entry in lib/apps.ts
MYAPP_LOGIN_PASSWORD=
MYAPP_LOGIN_USER=

# ── hub-wide ─────────────────────────────────────────────────────────────────
# Minutes before cached login states (.auth/<app>.json) are refreshed
AUTH_STATE_TTL_MIN=30

# Path to the Python autotest framework root (enables Python/pytest code generation)
AUTOTEST_FRAMEWORK_ROOT=
