# Python/Playwright test framework — environment overrides
#
# Most values (GRC_BASE_URL, GRC_LOGIN_USER, GRC_LOGIN_PASSWORD, etc.) already
# live in ../.env (automation-hub/.env) and are inherited automatically —
# config_manager.py loads automation-hub/python/.env first, then falls back
# to automation-hub/.env for anything not already set (first-loaded wins).
#
# Only add values here that are specific to this Python framework, or that
# should override the hub's .env for local/manual test runs.

# Active environment — must match a file in
# autotest_framework/config/environments/<name>.json
ENVIRONMENT=qa_grc

# Uncomment to override:
# HEADLESS=true
# BROWSER=chromium
# FULLSCREEN=false
# DEFAULT_USERNAME=
# DEFAULT_PASSWORD=
