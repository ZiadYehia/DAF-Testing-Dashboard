{
  "name": "ztestground",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 146",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "typeorm-ts-node-commonjs -d database/src/data-source.ts migration:generate database/src/migrations/AutoMigration",
    "db:migrate": "typeorm-ts-node-commonjs -d database/src/data-source.ts migration:run",
    "db:revert": "typeorm-ts-node-commonjs -d database/src/data-source.ts migration:revert",
    "db:import": "ts-node database/src/seed/import.ts",
    "db:backfill": "ts-node database/src/seed/import.ts",
    "db:export": "ts-node database/src/seed/export.ts",
    "db:seed-admin": "ts-node database/src/seed/seed-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@base-ui/react": "^1.6.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/bcrypt": "^1.10.7",
    "@opentelemetry/api": "^1.9.1",
    "@playwright/mcp": "^0.0.77",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/codemirror-theme-vscode": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "appium": "^3.5.2",
    "appium-mcp": "^1.87.3",
    "appium-uiautomator2-driver": "^8.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "groq-sdk": "^1.3.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "mssql": "^10.0.4",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^0.3.21",
    "webdriverio": "^9.29.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
