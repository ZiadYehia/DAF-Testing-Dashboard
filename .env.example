# Copy this file to .env.local and fill in real values. .env.local is git-ignored.
#
# ── EC2 / DOCKER COMPOSE DEPLOYMENT NOTE ───────────────────────────────────────
# docker-compose.yml runs three services: `app` (this repo, Dockerfile at root),
# `db` (official mcr.microsoft.com/mssql/server:2022-latest image), and `proxy`
# (Caddy, auto-provisions TLS). Set all vars below in the `.env` next to
# docker-compose.yml on the host — compose injects them into `app` and `db`.
# See docs/backup-restore.md for host setup and nightly backup config.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Auth (required) ─────────────────────────────────────────────────────────
# Random 32-byte hex secret used to sign session JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 32-byte key encrypting secrets (API keys/tokens) at rest in the settings table (AES-256-GCM).
# Accepts base64 or hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, secrets are stored in plaintext (backward compatible; a warning is logged).
APP_ENCRYPTION_KEY=

# Initial admin password — set on the FIRST deploy only; remove after the admin is created.
# If unset, no admin is seeded (safe to omit after bootstrapping).
SEED_ADMIN_EMAIL=admin@allendevaux.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=

# ─── Database (MSSQL) ─────────────────────────────────────────────────────────
# Set DB_SYNC=false in production — run migrations with: npm run db:migrate
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=TestingDashboard
DB_SYNC=false
DB_ENCRYPT=false
# Set to false in production when DB_ENCRYPT=true and the server has a CA-signed certificate.
DB_TRUST_CERT=true

# ─── AI providers (at least one) ─────────────────────────────────────────────
# Models are selectable in the UI; a model only appears enabled when its key is set.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ─── Jira Cloud (primary path) ───────────────────────────────────────────────
# Required to push bugs to Jira and to read user stories for Module Knowledge.
# Create a token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_PROJECT_KEY=DT
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional — add created bug issues to this Agile board id.
JIRA_BOARD_ID=

# ─── Jira Server / Data Center (alternative) ─────────────────────────────────
# If you're on self-hosted Jira, set a Personal Access Token here (Bearer auth).
# Leave JIRA_EMAIL + JIRA_API_TOKEN blank when using this.
# JIRA_PAT=

# ─── Optional ────────────────────────────────────────────────────────────────
# Override where QA data is read from (defaults to ./data).
# DATA_ROOT=

# Public hostname for the docker-compose Caddy proxy (HTTPS via Let's Encrypt).
# e.g. DOMAIN=<your-ip-dashes>.sslip.io — unset serves plain HTTP on port 80.
# DOMAIN=

# --- Backups (EC2 host cron -> S3; see docs/backup-restore.md) ---
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=mssql
# S3 prefix for the nightly data/ (binary assets) tarball backup.
BACKUP_S3_DATA_PREFIX=data
